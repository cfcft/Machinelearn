<UserControl x:Class="MachineLearn.Controls.PrismPager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Content="上一页" Width="70" Margin="2" Command="{Binding PrevCommand}" IsEnabled="{Binding CanPrev}"/>
        <TextBlock Width="120" TextAlignment="Center" VerticalAlignment="Center">
            <Run Text="{Binding CurrentPage}"/> / <Run Text="{Binding TotalPages}"/>
        </TextBlock>
        <Button Content="下一页" Width="70" Margin="2" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"/>
    </StackPanel>
</UserControl>
