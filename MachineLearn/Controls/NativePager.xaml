<UserControl x:Class="MachineLearn.Controls.NativePager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Content="上一页" Width="70" Margin="2" Command="{Binding PrevCommand}"/>
        <TextBlock x:Name="PageText" Width="120" TextAlignment="Center" VerticalAlignment="Center"/>
        <Button Content="下一页" Width="70" Margin="2" Command="{Binding NextCommand}"/>
    </StackPanel>
</UserControl>
