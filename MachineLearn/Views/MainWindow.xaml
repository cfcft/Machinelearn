<Window x:Class="MachineLearn.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MachineLearn"
        xmlns:controls="clr-namespace:MachineLearn.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="MainWindow" Height="1000" Width="2000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：菜单 -->
        <Menu x:Name="displayMenu" ItemsSource="{Binding MenuItems}" Grid.Row="0">
            <Menu.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding children}">
                    <TextBlock Text="{Binding Name}"/>
                </HierarchicalDataTemplate>
            </Menu.ItemTemplate>
        </Menu>

        <!-- 中间：两个分页控件对比 -->
        <Border BorderBrush="Blue" BorderThickness="2" Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：原生 WPF 分页控件 -->
                <Border Grid.Column="0" BorderBrush="Green" BorderThickness="2" Margin="5">
                    <StackPanel>
                        <TextBlock Text="NativePager（原生 WPF）" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>
                        <TextBlock Text="用 DependencyProperty + 路由事件" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                        <Separator Margin="5"/>
                        <controls:NativePager TotalPages="10" CurrentPage="1" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NativePagerStatus" Text="当前页: 1" HorizontalAlignment="Center" Margin="5" FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- 右侧：Prism 分页控件 -->
                <Border Grid.Column="1" BorderBrush="Red" BorderThickness="2" Margin="5">
                    <StackPanel>
                        <TextBlock Text="PrismPager（Prism MVVM）" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>
                        <TextBlock Text="用 DelegateCommand + INotifyPropertyChanged" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                        <Separator Margin="5"/>
                        <controls:PrismPager HorizontalAlignment="Center"/>
                        <TextBlock Text="按钮禁用状态自动更新" Foreground="Gray" HorizontalAlignment="Center" Margin="5" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 底部：数据采集页面占位 -->
        <Border BorderBrush="Orange" BorderThickness="2" Grid.Row="2" Margin="5">
            <Button Content="测试xml" Click="Button_Click"/>
        </Border>
    </Grid>
</Window>
